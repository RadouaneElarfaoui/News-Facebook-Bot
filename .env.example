# ============================================================
# fb-bot — Template de configuration (copier vers .env)
# ============================================================
# Commande : cp .env.example .env
# Puis remplir chaque valeur avec vos vraies clés.

# Facebook Graph API
FB_PAGE_ID=YOUR_FB_PAGE_ID
FB_ACCESS_TOKEN=YOUR_FB_ACCESS_TOKEN

# GNews API
GNEWS_API_KEY=YOUR_GNEWS_API_KEY

# Banques d'images (au moins une recommandée)
PEXELS_API_KEY=YOUR_PEXELS_API_KEY
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY

# Publication Facebook (true = simulation sans publication réelle, false = production)
IS_DRAFT=true

# Docker : UID/GID de l'utilisateur hôte (résultat de `id -u` / `id -g`)
# Sur certains VPS (ex. Oracle Cloud) l'utilisateur "ubuntu" a l'UID 1001 et non 1000.
# BOT_UID=1000
# BOT_GID=1000

# Optionnel : personnalisation Antigravity CLI (agy)
# AGY_BINARY=agy
# AGY_HOME=data/agy-home
